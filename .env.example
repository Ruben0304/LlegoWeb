# Backend Configuration
# Esta variable es PRIVADA (sin PUBLIC_) - solo accesible desde el servidor de Astro
# Para Railway, usa el dominio privado: [nombre-servicio].railway.internal
# IMPORTANTE: NO incluyas /graphql aquí. El cliente GraphQL lo agregará automáticamente.
# Esta URL base también se usará para endpoints REST.
BACKEND_URL=https://tu-backend.railway.internal
PUBLIC_BACKEND_URL=https://llegobackend-production.up.railway.app

# Public Frontend Configuration
# Estas variables se exponen al cliente (prefix PUBLIC_)
PUBLIC_GOOGLE_CLIENT_ID=309268628843-vafbp3o66ul2ea1g2bo6h9bpraqk5sj0.apps.googleusercontent.com

# Apple Sign-In Configuration
# No necesitas configurar nada aquí para Apple Sign-In
# El flujo OAuth lo maneja completamente el backend
# El redirect_uri de Apple Developer debe apuntar al BACKEND:
# https://llegobackend-production.up.railway.app/apple/callback

# ---------------------------------------------------------------------------
# Backend (solo servidor: sin prefijo PUBLIC_, nunca llega al navegador)
# ---------------------------------------------------------------------------
# URL BASE del backend, SIN /graphql (el cliente añade /graphql y los endpoints
# REST como /download/android cuelgan de la misma base).
#   - Local: http://localhost:8000
#   - Railway, dominio público: https://llegobackend-production.up.railway.app
#   - Railway, red privada: http://<servicio-backend>.railway.internal:<PUERTO>
#     (http, no https, y con el puerto en el que escucha el backend)
BACKEND_URL=http://localhost:8000

# Secreto compartido con el backend (misma variable WEB_PROXY_SECRET en los dos
# servicios). Con él, el backend acepta la IP del visitante que reenvía la web
# (login social, descarga del APK) y su rate limit cuenta por visitante.
# Vacío = no se reenvía la IP. Genera uno largo y aleatorio (p. ej. openssl rand -hex 32).
WEB_PROXY_SECRET=

# ---------------------------------------------------------------------------
# Configuración pública (prefijo PUBLIC_: se incluye en el JavaScript del navegador)
# ---------------------------------------------------------------------------
# URL pública del backend: el navegador la usa para GraphQL de los paneles y del
# registro de socios, las subidas de archivos y /apple/start.
PUBLIC_BACKEND_URL=https://llegobackend-production.up.railway.app

# Client ID de Google de tipo "Aplicación web" (Google Identity Services en el
# navegador). No uses el de iOS: no tiene orígenes de JavaScript autorizados.
# Añade el dominio de la web en "Orígenes de JavaScript autorizados" del cliente.
PUBLIC_GOOGLE_CLIENT_ID=309268628843-no826lc6m63tn2b30q542q53ea1ffpbe.apps.googleusercontent.com

# Apple Sign-In: no necesita variables aquí. El flujo OAuth lo maneja el backend
# (/apple/start?redirect_scheme=<origen>/auth/callback) y la URL de callback de la
# web tiene que estar en WEB_AUTH_CALLBACK_URLS del backend. El redirect_uri
# configurado en Apple Developer apunta al backend:
# https://llegobackend-production.up.railway.app/apple/callback


---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/common/Navbar.svelte";
import Footer from "../components/common/Footer.svelte";
import { Hero, Cartelera, TiraPelicula, DosOrillas, Ecosistema, Cierre } from "../components/home";

const title =
    "Llegó | Delivery en Cuba con IA: restaurantes, ropa, mercado y más";
const description =
    "Llegó es la app de delivery en Cuba para todo tipo de negocios, cerca de ti o fuera de tu municipio. Búscalo hablando con la IA y paga desde Cuba o desde el exterior.";
---

<Layout title={title} description={description}>
    <Navbar client:load />
    <main>
        <Hero />
        <Cartelera />
        <TiraPelicula />
        <DosOrillas />
        <Ecosistema />
        <Cierre />
    </main>
    <Footer />
</Layout>

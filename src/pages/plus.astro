---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.svelte';
import ComingSoon from '../components/common/ComingSoon.astro';
import Footer from '../components/common/Footer.svelte';

const title = "Llegó+, próximamente";
const description = "Llegó+ llegará pronto. Todavía no está disponible ni tiene precio definido.";
const keywords = "Llegó+, próximamente, delivery Cuba";
---

<Layout title={title} description={description} keywords={keywords}>
  <Navbar client:load />
  <main>
    <ComingSoon
      eyebrow="Llegó+"
      title="Llegó+ llegará pronto"
      description="Estamos preparando Llegó+, una suscripción con ventajas extra para quienes compran con Llegó. Todavía no está disponible ni tiene precio definido. Mientras tanto, descarga la app y empieza a pedir."
      primaryHref="/#descargar"
      primaryLabel="Descargar la app"
      secondaryHref="/"
      secondaryLabel="Volver al inicio"
    />
  </main>
  <Footer />
</Layout>

---
// Auth callback page - handles OAuth redirects from backend
import "@fontsource-variable/big-shoulders-display";
import "@fontsource-variable/figtree";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- La URL trae el JWT (?token=): ni se indexa ni viaja en el Referer. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Autenticando...</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Mismas tintas que el sitio (ver DESIGN.md); página suelta, sin Layout */
      body {
        font-family: 'Figtree Variable', -apple-system, 'Segoe UI', Roboto, sans-serif;
        background: #fff7e6;
        color: #023133;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
      }

      .container {
        text-align: center;
        max-width: 420px;
      }

      /* La caja recorre su ruta mientras se valida la sesión */
      .icon {
        position: relative;
        width: 220px;
        height: 70px;
        margin: 0 auto 28px;
      }

      .icon::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 10px;
        border-top: 3px dashed #127368;
      }

      .spinner {
        position: absolute;
        left: 0;
        bottom: 12px;
        width: 72px;
        height: 47px;
        background: url("/img/logo-caja-320.webp") center / contain no-repeat;
        animation: route 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite alternate;
      }

      @keyframes route {
        to { transform: translateX(148px); }
      }

      @media (prefers-reduced-motion: reduce) {
        .spinner {
          animation: none;
          left: 74px;
        }
      }

      h1 {
        font-family: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
        font-size: 44px;
        font-weight: 900;
        text-transform: uppercase;
        line-height: 0.98;
        margin-bottom: 12px;
        text-shadow: 0.045em 0.035em 0 #ec9844;
      }

      p {
        color: rgba(2, 49, 51, 0.8);
        font-size: 16px;
        line-height: 1.5;
      }

      .error {
        background: rgba(200, 60, 40, 0.1);
        border: 2px solid rgba(163, 48, 28, 0.55);
        padding: 16px;
        margin-top: 24px;
        color: #a3301c;
        text-align: left;
      }

      .error-title {
        font-weight: 700;
        margin-bottom: 6px;
        font-size: 16px;
      }

      .error-message {
        font-size: 15px;
        color: #a3301c;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        min-height: 48px;
        margin-top: 24px;
        padding: 10px 24px;
        background: #023133;
        border-radius: 6px;
        color: #fff7e6;
        text-decoration: none;
        font-family: 'Big Shoulders Display Variable', 'Arial Narrow', sans-serif;
        font-size: 20px;
        font-weight: 800;
        text-transform: uppercase;
        transition: background-color 0.2s ease;
      }

      .back-link:hover {
        background: #127368;
      }

      .back-link:focus-visible {
        outline: 3px solid #127368;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon">
        <div class="spinner"></div>
      </div>
      <h1 id="status-title">Autenticando...</h1>
      <p id="status-message">Por favor espera un momento</p>
      <div id="error-container" style="display: none;"></div>
    </div>

    <script>
      import { consumeAppleState, consumeReturnTo, decodeJwtPayload, storeSession } from '@/lib/auth/session';

      // Si nadie pidió volver a otra página (p. ej. /negocios), el login web es
      // el del panel de tutoriales.
      const DEFAULT_RETURN_TO = '/tutoriales';

      function showError(title: string, message: string, backHref: string) {
        const titleEl = document.getElementById('status-title');
        const messageEl = document.getElementById('status-message');
        const errorContainer = document.getElementById('error-container');
        const spinner = document.querySelector('.spinner');

        if (titleEl) titleEl.textContent = title;
        if (messageEl) messageEl.style.display = 'none';
        
        if (errorContainer) {
          // El mensaje llega por la URL (?message=): jamás se inserta como HTML.
          // Se construye el DOM con textContent para evitar XSS en un origen que
          // guarda el JWT en localStorage.
          errorContainer.replaceChildren();

          const errorBox = document.createElement('div');
          errorBox.className = 'error';

          const errorTitle = document.createElement('div');
          errorTitle.className = 'error-title';
          errorTitle.textContent = title;

          const errorMessage = document.createElement('div');
          errorMessage.className = 'error-message';
          errorMessage.textContent = message;

          errorBox.append(errorTitle, errorMessage);

          const backLink = document.createElement('a');
          backLink.href = backHref;
          backLink.className = 'back-link';
          backLink.textContent = backHref === '/' ? 'Volver al inicio' : 'Volver e intentarlo de nuevo';

          errorContainer.append(errorBox, backLink);
          errorContainer.style.display = 'block';
        }

        if (spinner) (spinner as HTMLElement).style.display = 'none';
      }

      function handleCallback() {
        try {
          const params = new URLSearchParams(window.location.search);
          const token = params.get('token');
          const error = params.get('error');
          const errorMessage = params.get('message');
          const state = params.get('state');

          // El JWT llega en la URL (?token=...). Se quita de la barra y del
          // historial antes de nada: así no queda en "atrás", en el historial del
          // navegador ni en el Referer de la página siguiente.
          if (window.location.search) {
            history.replaceState(history.state, '', window.location.pathname);
          }

          if (error) {
            console.error('Auth error:', error, errorMessage);
            showError(
              'Error de autenticación',
              errorMessage || 'No se pudo completar la autenticación. Por favor intenta nuevamente.',
              consumeReturnTo('/')
            );
            return;
          }

          // El token solo vale si este navegador empezó el login (mismo state)
          if (token && !consumeAppleState(state)) {
            showError(
              'No se pudo verificar el inicio de sesión',
              'Este enlace no viene de un inicio de sesión que empezaras aquí. Vuelve a entrar desde la página.',
              consumeReturnTo('/')
            );
            return;
          }

          if (!token) {
            showError(
              'Token no encontrado',
              'No se recibió un token de autenticación válido.',
              consumeReturnTo('/')
            );
            return;
          }

          // Datos de pantalla del JWT (sin verificar: lo verifica el backend en
          // cada operación). El backend firma { sub: email, user_id, role }.
          const payload = decodeJwtPayload(token);
          storeSession(
            token,
            payload
              ? {
                  id: payload.user_id || payload.sub,
                  name: payload.name || payload.email?.split('@')[0] || payload.sub?.split('@')[0] || 'Usuario',
                  email: payload.email || payload.sub,
                  role: payload.role || 'customer',
                }
              : null
          );

          // replace y no href: la página del callback no queda en el historial.
          window.location.replace(consumeReturnTo(DEFAULT_RETURN_TO));
        } catch (error) {
          console.error('Callback error:', error);
          showError(
            'Error inesperado',
            'Ocurrió un error al procesar la autenticación.',
            '/'
          );
        }
      }

      // Execute on page load
      handleCallback();
    </script>
  </body>
</html>

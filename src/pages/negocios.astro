---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.svelte';
import PartnerSignup from '../components/negocios/PartnerSignup.svelte';
import Footer from '../components/common/Footer.svelte';

const title = "Negocios y mensajeros";
const description = "Vende en Llegó o reparte pedidos en tu zona: envía tu solicitud y te llamamos para conocerte.";
---

<!-- noindex: la página muestra la sesión y la solicitud de cada usuario. -->
<Layout title={title} description={description} noindex>
  <Navbar client:load />
  <main>
    <PartnerSignup client:load />
  </main>
  <Footer />
</Layout>

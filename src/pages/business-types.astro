---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.svelte';
import BusinessTypePanel from '../components/business-types/BusinessTypePanel.svelte';
import Footer from '../components/common/Footer.svelte';
import '../styles/business-types.css';

const title = "Gestión de Business Types";
const description = "Panel de administración para gestionar los tipos de negocio en Llegó.";
---

<!-- noindex: panel de administración (también bloqueado en robots.txt). -->
<Layout title={title} description={description} noindex>
  <Navbar client:load />
  <main class="business-types-page">
    <BusinessTypePanel client:load />
  </main>
  <Footer />
</Layout>

<style>
  .business-types-page {
    min-height: 100vh;
    padding-top: 100px;
  }
</style>

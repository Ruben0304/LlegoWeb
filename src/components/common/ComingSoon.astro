---
/**
 * Página "Próximamente" reutilizable (hoy /plus).
 * Sin precios, métricas ni acciones que no existan todavía.
 */
interface Props {
  title: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const { title, description, primaryHref, primaryLabel, secondaryHref, secondaryLabel } = Astro.props;
// Los enlaces http(s) (p. ej. WhatsApp) se abren en otra pestaña.
const opensNewTab = primaryHref.startsWith('http');
---

<section class="coming-soon">
  <div class="coming-soon-inner">
    <h1 class="title">{title}</h1>
    <p class="description">{description}</p>
    <div class="actions">
      <a
        href={primaryHref}
        class="btn btn-primary"
        target={opensNewTab ? '_blank' : undefined}
        rel={opensNewTab ? 'noopener noreferrer' : undefined}
      >{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a href={secondaryHref} class="btn btn-secondary">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .coming-soon {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 20px 80px;
    background: var(--color-background);
  }

  .coming-soon-inner {
    max-width: 560px;
    width: 100%;
    text-align: center;
  }

  .title {
    font-size: clamp(28px, 6vw, 40px);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .description {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 32px;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

</style>

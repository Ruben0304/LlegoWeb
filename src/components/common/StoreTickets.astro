---
/**
 * Las dos descargas (App Store y APK de Android) como entradas de cine.
 * `tone` elige las tintas según el campo de color sobre el que van.
 */
import { ANDROID_DOWNLOAD_PATH, APP_STORE_URL } from "@/lib/site";

interface Props {
  tone?: "ink" | "paper" | "teal";
  id?: string;
}

const { tone = "ink", id } = Astro.props;
const first = tone === "ink" ? "" : tone === "paper" ? "ticket--paper" : "ticket--teal";
const second = tone === "ink" ? "ticket--paper" : tone === "paper" ? "" : "ticket--paper";
---

<div class="store-tickets" id={id}>
  <a href={APP_STORE_URL} class:list={["ticket", first]}>
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"></path>
    </svg>
    <span class="ticket-label">
      <span class="ticket-small">Descargar en</span>
      <span class="ticket-big">App Store</span>
    </span>
  </a>
  <a href={ANDROID_DOWNLOAD_PATH} class:list={["ticket", second]}>
    <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24" aria-hidden="true">
      <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 9.99l-2.302 2.302-8.634-8.634z"></path>
    </svg>
    <span class="ticket-label">
      <span class="ticket-small">Descargar para Android</span>
      <span class="ticket-big">APK</span>
    </span>
  </a>
</div>

<style>
  .store-tickets {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .store-tickets .ticket {
    min-width: 196px;
    min-height: 60px;
    padding: 10px 26px 10px 22px;
  }

  .store-tickets .ticket-big {
    font-size: 1.6rem;
  }
</style>

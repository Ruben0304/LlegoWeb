---
/**
 * Cierre: último cartel en tinta sol con las descargas.
 */
import PrintTitle from "../common/PrintTitle.astro";
import StoreTickets from "../common/StoreTickets.astro";
---

<section class="cierre" aria-labelledby="cierre-title">
  <div class="container cierre-inner">
    <PrintTitle id="cierre-title" class="cierre-title" lines={["¿Qué pides", "hoy?"]} under="var(--ink-orange)" />
    <div class="cierre-side">
      <img class="cierre-box" src="/img/logo-caja-720.webp" srcset="/img/logo-caja-320.webp 320w, /img/logo-caja-720.webp 720w" sizes="(min-width: 900px) 340px, 220px" width="720" height="472" alt="" loading="lazy" decoding="async" />
      <p class="cierre-text">Descarga Llegó gratis y haz tu primer pedido.</p>
      <StoreTickets tone="ink" />
    </div>
  </div>
</section>

<style>
  .cierre {
    background: var(--ink-sun);
    color: var(--ink);
    padding: clamp(72px, 10vw, 128px) 0;
  }

  .cierre-inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }

  :global(.cierre-title) {
    font-size: clamp(64px, 14vw, 176px);
  }

  .cierre-box {
    width: clamp(200px, 26vw, 340px);
    height: auto;
    margin-bottom: 20px;
    transform: rotate(-7deg) translateX(-4%);
    filter: drop-shadow(8px 10px 0 rgba(2, 49, 51, 0.2));
  }

  .cierre-text {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  @media (min-width: 900px) {
    .cierre-inner {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>

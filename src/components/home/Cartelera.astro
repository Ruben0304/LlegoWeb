---
/**
 * Categorías como una pared de carteles de la misma serie: cada uno en su
 * campo de tinta, con una ilustración a dos tintas desplazadas.
 */
import PrintTitle from "../common/PrintTitle.astro";

type Poster = {
  id: string;
  title: string;
  text: string;
  /** campo, texto, tinta A y tinta B de la ilustración */
  field: string;
  fg: string;
  a: string;
  b: string;
  art: string;
};

const posters: Poster[] = [
  {
    id: "restaurantes",
    title: "Restaurantes",
    text: "De la paladar de la esquina a la pizzería del otro municipio.",
    field: "var(--ink-orange)",
    fg: "var(--ink)",
    a: "var(--paper)",
    b: "var(--ink-teal)",
    // plato y cubiertos
    art: `<circle class="a" cx="60" cy="62" r="40"/><circle class="b-line" cx="60" cy="62" r="27"/><rect class="b" x="9" y="18" width="7" height="84" rx="3.5"/><path class="b" d="M101 18c8 6 10 20 10 32 0 8-4 12-9 13v39h-7V18z"/>`,
  },
  {
    id: "ropa",
    title: "Ropa",
    text: "Moda y estilo para toda la familia.",
    field: "var(--ink-teal)",
    fg: "var(--paper)",
    a: "var(--ink-sun)",
    b: "var(--ink-teal-dark)",
    // guayabera con sus alforzas
    art: `<path class="a" d="M42 14 60 22 78 14l30 16-10 22-10-5v59H32V47l-10 5-10-22z"/><path class="b-line" d="M46 40v62M54 40v62M66 40v62M74 40v62M60 22v80"/>`,
  },
  {
    id: "mercado",
    title: "Mercado",
    text: "Lo de la casa, sin hacer la cola.",
    field: "var(--ink-sun)",
    fg: "var(--ink)",
    a: "var(--ink-orange)",
    b: "var(--ink-teal)",
    // jaba con asas
    art: `<path class="a" d="M22 40h76l-8 66H30z"/><path class="b-line" d="M42 40c0-26 36-26 36 0"/><path class="b" d="M28 52h64l-2 12H30z"/>`,
  },
  {
    id: "agro",
    title: "Agro",
    text: "Productos frescos directo del campo.",
    field: "var(--ink-green)",
    fg: "var(--ink)",
    a: "var(--ink-orange)",
    b: "var(--ink-teal)",
    // mango con hoja
    art: `<path class="a" d="M60 30c26 0 42 22 38 46-4 22-24 32-42 30-22-2-38-20-34-44 3-18 18-32 38-32z"/><path class="b" d="M60 32c-4-14 4-24 20-26-2 14-8 22-20 26z"/><path class="b-line" d="M60 32c2-6 4-10 8-14"/>`,
  },
  {
    id: "perfumeria",
    title: "Perfumería",
    text: "Fragancias y cuidado personal.",
    field: "var(--paper-deep)",
    fg: "var(--ink)",
    a: "var(--ink-leaf)",
    b: "var(--ink-orange)",
    // frasco con atomizador
    art: `<rect class="a" x="30" y="46" width="60" height="62" rx="10"/><rect class="b" x="50" y="30" width="20" height="16" rx="2"/><path class="b-line" d="M70 36h14M84 36c6 0 10 4 10 10"/><circle class="b" cx="96" cy="52" r="7"/><rect class="b" x="40" y="66" width="40" height="22" rx="3"/>`,
  },
];
---

<section class="cartelera" id="categorias" aria-labelledby="cartelera-title">
  <div class="container">
    <header class="cartelera-head">
      <PrintTitle
        id="cartelera-title"
        class="cartelera-title"
        lines={["Una app,", "todos los negocios"]}
        accent={1}
      />
      <p class="cartelera-lede">
        Encuentra negocios cerca de ti o fuera de tu municipio. Cada categoría tiene su cartel;
        dentro de la app, cada negocio tiene su tienda.
      </p>
    </header>

    <ul class="wall">
      {posters.map((p) => (
        <li class:list={["poster", `poster--${p.id}`]} style={`--field: ${p.field}; --fg: ${p.fg}; --a: ${p.a}; --b: ${p.b}`}>
          <svg class="poster-art" viewBox="0 0 120 120" aria-hidden="true">
            <g class="layer-a" set:html={p.art} />
            <g class="layer-b" set:html={p.art} />
          </svg>
          <h3 class="poster-title">{p.title}</h3>
          <p class="poster-text">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cartelera {
    background: var(--paper);
    padding: var(--section-y) 0;
  }

  .cartelera-head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  :global(.cartelera-title) {
    font-size: clamp(52px, 10vw, 128px);
  }

  .cartelera-lede {
    max-width: 44ch;
    font-size: 18px;
    color: var(--ink-soft);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .poster {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 240px;
    padding: 20px 18px 22px;
    background: var(--field);
    color: var(--fg);
    overflow: hidden;
  }

  .poster--restaurantes {
    grid-column: span 2;
    min-height: 320px;
  }

  .poster--perfumeria {
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .poster-art {
    position: absolute;
    top: 14px;
    right: 10px;
    width: 46%;
    max-width: 220px;
    height: auto;
    overflow: visible;
  }

  /*
   * Dos pasadas de la misma forma: la tinta A rellena y la B dibuja encima,
   * con el fuera de registro de la serigrafía.
   */
  .poster-art :global(.layer-a .a),
  .poster-art :global(.layer-a .b) {
    fill: var(--a);
  }

  .poster-art :global(.layer-a .b-line) {
    fill: none;
    stroke: var(--a);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .poster-art :global(.layer-b) {
    transform: translate(4px, 3px);
    mix-blend-mode: multiply;
  }

  .poster-art :global(.layer-b .a) {
    fill: none;
  }

  .poster-art :global(.layer-b .b) {
    fill: var(--b);
  }

  .poster-art :global(.layer-b .b-line) {
    fill: none;
    stroke: var(--b);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .poster-title {
    position: relative;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(28px, 7.4vw, 64px);
    line-height: 0.9;
    margin-bottom: 8px;
  }

  .poster-text {
    position: relative;
    max-width: 26ch;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .cartelera-head {
      grid-template-columns: 1.3fr 1fr;
      align-items: end;
    }

    .wall {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-auto-rows: 200px;
      gap: 16px;
    }

    .poster {
      min-height: 0;
      padding: 28px 28px 30px;
    }

    .poster--restaurantes {
      grid-column: 1 / span 3;
      grid-row: span 2;
    }

    .poster--ropa {
      grid-column: 4 / span 3;
    }

    .poster--mercado {
      grid-column: 4 / span 2;
    }

    .poster--agro {
      grid-column: 6 / span 1;
      grid-row: span 2;
    }

    .poster--perfumeria {
      grid-column: 1 / span 5;
    }

    .poster--agro .poster-art {
      width: 80%;
    }

    .poster--agro .poster-title {
      font-size: 44px;
    }

    .poster--restaurantes .poster-art {
      width: 54%;
      max-width: 300px;
    }
  }
</style>

---
/**
 * Estructura común de las páginas informativas y legales
 * (/privacidad, /terminos, /soporte, /eliminar-cuenta): la misma navegación y
 * el mismo pie que el resto del sitio, con el contenido en una columna de lectura.
 */
import Layout from "./Layout.astro";
import Navbar from "../components/common/Navbar.svelte";
import Footer from "../components/common/Footer.svelte";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
    <Navbar client:load />
    <main class="content">
        <slot />
    </main>
    <Footer />
</Layout>

<style>
    .content {
        max-width: 720px;
        margin: 0 auto;
        padding: 128px 24px 96px;
        color: var(--color-text);
    }

    @media (max-width: 640px) {
        .content {
            padding: 104px 20px 72px;
        }
    }
</style>
